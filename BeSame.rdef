/*
 * BeSame resources
 */

resource app_signature "application/x-vnd.idumych-BeSame";

resource app_name_catalog_entry "x-vnd.idumych-BeSame:System name:BeSame";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 1,
	middle = 1,
	minor  = 1,

	variety = B_APPV_FINAL,
	internal = 0,

	short_info = "BeSame",
	long_info = "BeSame 1.1.1 ©1999 Michael Wulff Nielsen; native Haiku port 2026"
};

// The icon from Michel Clasquin-Johnson's Haiku package of the original
resource vector_icon import "art/BeSame.hvif";

// The original's pictures: balls (a row per colour, a column per frame),
// the title logo and the game-over banner. Raw pixels made from the PNGs by
// tools/png2raw.py, so no translator is needed.
resource(1, "balls") #'BSRW' import "art/balls.raw";
resource(2, "logo") #'BSRW' import "art/logo.raw";
resource(3, "gameover") #'BSRW' import "art/gameover.raw";
